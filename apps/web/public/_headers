# Cloudflare Pages response headers (served only in production hosting; local preview ignores this file).
# No Content-Security-Policy yet: AdSense and consent scripts load from many Google origins, so a CSP must be
# written and tested together with the live ad setup (docs/08-launch-checklist.md).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: SAMEORIGIN

# Hashed build assets never change, so cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Ad files must always be fresh so ad networks read the current version.
/ads.txt
  Cache-Control: public, max-age=3600
/app-ads.txt
  Cache-Control: public, max-age=3600
