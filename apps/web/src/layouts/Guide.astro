---
import Base from "./Base.astro";
import AdSlot from "../components/AdSlot.astro";
import SourcesList from "../components/SourcesList.astro";
import { GUIDES } from "../data/guides";
import { TOOLS } from "../data/tools";
import { SITE_URL } from "../data/site";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const guide = GUIDES.find((g) => g.slug === slug);
if (!guide) throw new Error(`Unknown guide "${slug}": add it to src/data/guides.ts`);
const url = `${SITE_URL}/guides/${slug}/`;
const related = TOOLS.filter((t) => guide.tools.includes(t.path));
const others = GUIDES.filter((g) => g.slug !== slug);
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: guide.title,
    description: guide.description,
    dateModified: guide.updated,
    datePublished: guide.updated,
    mainEntityOfPage: url,
    author: { "@type": "Organization", name: "Haul Numbers", url: SITE_URL },
    publisher: { "@type": "Organization", name: "Haul Numbers", url: SITE_URL },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Guides", item: `${SITE_URL}/guides/` },
      { "@type": "ListItem", position: 2, name: guide.title, item: url },
    ],
  },
];
---
<Base title={guide.title} description={guide.description} jsonLd={jsonLd}>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/guides/">Guides</a> <span aria-hidden="true">›</span> <span>{guide.title}</span></nav>
  <article class="article">
    <h1>{guide.title}</h1>
    <p class="meta">
      Updated {guide.updated}.
      {guide.reviewed && <> Reviewed against its sources {guide.reviewed}.</>}
      {" "}Figures in examples are illustrative, not typical costs.
    </p>
    <slot />
  </article>

  <AdSlot page="guide" />

  {guide.sources && guide.sources.length > 0 && <SourcesList sources={guide.sources} />}

  <section>
    <h2>Related calculators</h2>
    <ul class="related">
      {related.map((t) => (
        <li class="card"><a href={t.path}><strong>{t.name}</strong></a><p>{t.blurb}</p></li>
      ))}
    </ul>
    <h2>More guides</h2>
    <ul class="related">
      {others.map((g) => (
        <li class="card"><a href={`/guides/${g.slug}/`}><strong>{g.title}</strong></a><p>{g.description}</p></li>
      ))}
    </ul>
  </section>
</Base>
