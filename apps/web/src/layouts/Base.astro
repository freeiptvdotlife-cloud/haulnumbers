---
import "../styles/theme.css";
import "../styles/tool.css";
import Icon from "../components/Icon.astro";
import { TOOLS } from "../data/tools";
interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Keep this page out of search results (e.g. the 404 page). */
  noindex?: boolean;
}
const { title, description, jsonLd, noindex = false } = Astro.props;
// PUBLIC_NOINDEX=1 marks a whole build as a staging copy so it is never indexed. The compliance gate rejects it in a monetised build.
const hideFromSearch = noindex || import.meta.env.PUBLIC_NOINDEX === "1";
const ogImage = new URL("/og-default.png", Astro.site).href;
// Identifies the AdSense account for site verification WITHOUT loading any ad script (the loader is only ever included by AdSlot).
const adsenseAccount = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const here = Astro.url.pathname;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#09090b" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {adsenseAccount && <meta name="google-adsense-account" content={adsenseAccount} />}
    {hideFromSearch && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Haul Numbers" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <a class="brand" href="/"><span class="mark"><Icon name="truck" size={20} /></span>Haul Numbers</a>
      <nav class="main" aria-label="Main">
        {TOOLS.map((t) => (<a href={t.path} aria-current={here === t.path ? "page" : undefined}><Icon name={t.icon} size={16} />{t.navLabel}</a>))}
        <a href="/guides/" aria-current={here.startsWith("/guides/") ? "page" : undefined}><Icon name="book" size={16} />Guides</a>
      </nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site">
      <p>© {new Date().getFullYear()} Haul Numbers. Estimates only, not financial, tax or legal advice.</p>
      <nav aria-label="Footer"><a href="/calculators/">All calculators</a> · <a href="/guides/">Guides</a> · <a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></nav>
    </footer>
  </body>
</html>
