---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { TOOLS } from "../../data/tools";
import { SITE_URL } from "../../data/site";

export async function getStaticPaths() {
  return (await getCollection("news")).map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, sources, tools } = post.data;
const day = date.toISOString().slice(0, 10);
const url = `${SITE_URL}/news/${post.id}/`;
const related = TOOLS.filter((t) => tools.includes(t.path));
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    datePublished: day,
    dateModified: day,
    mainEntityOfPage: url,
    author: { "@type": "Organization", name: "Haul Numbers", url: SITE_URL },
    publisher: { "@type": "Organization", name: "Haul Numbers", url: SITE_URL },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Digest", item: `${SITE_URL}/news/` },
      { "@type": "ListItem", position: 2, name: title, item: url },
    ],
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/news/">Digest</a> <span aria-hidden="true">›</span> <span>{title}</span></nav>
  <article class="article">
    <h1>{title}</h1>
    <p class="meta"><time datetime={day}>{day}</time>. Drafted with AI from the reports linked below and reviewed by an editor before publishing. Read the originals for the full story.</p>
    <Content />
    <h2>Sources</h2>
    <ul>
      {sources.map((s) => <li><a href={s.url} rel="noopener">{s.publisher}: {s.title}</a></li>)}
    </ul>
  </article>
  {related.length > 0 && (
    <section>
      <h2>Related calculators</h2>
      <ul class="related">
        {related.map((t) => <li class="card"><a href={t.path}><strong>{t.name}</strong></a><p>{t.blurb}</p></li>)}
      </ul>
    </section>
  )}
</Base>
