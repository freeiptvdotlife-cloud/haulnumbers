---
import { ICONS, type IconName } from "../lib/icons";
interface Props { name: IconName; size?: number }
const { name, size = 18 } = Astro.props;
---
<svg class="ico" viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {ICONS[name].map((d) => <path d={d} />)}
</svg>
