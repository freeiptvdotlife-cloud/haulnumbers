---
import Icon from "./Icon.astro";
import { iconFor } from "../lib/icons";
interface Props {
  legend: string;
  /** "fields": responsive grid of inputs. "block": plain container for custom layouts. */
  layout?: "fields" | "block";
}
const { legend, layout = "fields" } = Astro.props;
---
<fieldset class={layout}>
  <legend><span class="ico-tile"><Icon name={iconFor(legend)} size={16} /></span>{legend}</legend>
  <slot />
</fieldset>
