---
// Google Analytics 4 tag. Renders nothing when PUBLIC_GA_MEASUREMENT_ID is unset.
// Must appear in <head> AFTER ConsentMode.astro — that component sets analytics_storage
// to 'denied' so no data is sent until the visitor grants consent via ConsentManager.
const id = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

{id && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`}></script>
    <script is:inline define:vars={{ gaId: id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = window.gtag || gtag;
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
)}
