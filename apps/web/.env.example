# Copy to .env for a monetised build. Leave everything empty for development and pre-approval builds.
# `npm run check:compliance` (run after `npm run build:web`) fails if these are inconsistent.

# Public contact address shown on /contact/ and referenced from the privacy policy. Required before ads go live.
PUBLIC_CONTACT_EMAIL=

# AdSense publisher id (ca-pub-XXXXXXXXXXXXXXXX) and one ad unit id per page, set only after approval.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_CPM=
PUBLIC_ADSENSE_SLOT_LOAD=
PUBLIC_ADSENSE_SLOT_DETENTION=
PUBLIC_ADSENSE_SLOT_IFTA=
PUBLIC_ADSENSE_SLOT_PERDIEM=

# Exact snippets copied from the AdSense / AdMob consoles; separate several lines with "|".
# Example format: google.com, pub-0000000000000000, DIRECT, f08c47fec0942fa0
ADS_TXT=
APP_ADS_TXT=
